<div class="modules_product-display-page_product-selection">
  <%= label_tag "option_type_#{option_type.id}", option_type.presentation, class: "block mb-3 font-sans-md" %>

  <div class="select-input">
    <%= select_tag(
      "option_type_#{option_type.id}",
      options_from_collection_for_select(option_values(product: product, option_type: option_type), :id, :presentation),
      class: "min-w-[240px]",
      "data-option-index": index
    ) %>
  </div>
</div>
